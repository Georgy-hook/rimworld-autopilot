<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RIMAPI</RootNamespace>
    <AssemblyName>RIMAPI</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.10.0</Version>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.5 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.5'">
    <OutputPath>..\..\1.5\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_5</DefineConstants>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.6 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.6'">
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
  </PropertyGroup>

  <!-- Default output path for Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- Embed the source git hash into AssemblyInformationalVersion. -->
  <Target Name="SetSourceRevisionId" BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevisionRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevisionExitCode" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_GitRevisionExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitRevisionRaw.Trim())', '^[0-9a-fA-F]{7,40}$'))">$(_GitRevisionRaw.Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <!-- RimWorld 1.5 dependencies -->
    <PackageReference
      Include="Krafs.Rimworld.Ref"
      Version="1.5.4104"
      Condition="'$(Configuration)' == 'Release-1.5' OR '$(Configuration)' == 'Debug'"
    />

    <!-- RimWorld 1.6 dependencies -->
    <PackageReference
      Include="Krafs.Rimworld.Ref"
      Version="1.6.4871"
      Condition="'$(Configuration)' == 'Release-1.6'"
    />

    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <HintPath>..\..\Libraries\Newtonsoft.Json.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
  <!-- Laboratory endpoints exist only in an explicitly selected test build. -->
  <PropertyGroup Condition="'$(CombatLab)' == 'true'">
    <DefineConstants>$(DefineConstants);LAYA_COMBAT_LAB</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CombatLab)' == 'true'">
    <Compile Include="$(MSBuildProjectDirectory)/../../../../tests/native_combat_lab/*.cs" />
  </ItemGroup>
</Project>
